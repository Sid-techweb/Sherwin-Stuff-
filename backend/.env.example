NODE_ENV=development
PORT=4100
DATABASE_URL=postgres://bmw:bmw_dev_password@localhost:5440/bmw
REDIS_URL=redis://localhost:6390
# Must be >= 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-real-deployments-please-32chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
DASHBOARD_CACHE_TTL_SECONDS=60
ALERT_SCAN_INTERVAL_MS=300000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
TEST_DATABASE_URL=postgres://bmw:bmw_dev_password@localhost:5440/bmw_test

# ---- AI assistant (optional) --------------------------------------------------------------
# Without an LLM key the assistant still works in "data-only" mode (answers built directly from PostgreSQL).
# LLM_PROVIDER: none | anthropic | openai   ("openai" = any OpenAI-compatible API, set LLM_BASE_URL for others)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Hindsight long-term memory (optional). Leave empty to use only the local memory ledger.
# e.g. HINDSIGHT_URL=http://localhost:8888   (docker compose --profile ai up -d hindsight)
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=bmw-operations
